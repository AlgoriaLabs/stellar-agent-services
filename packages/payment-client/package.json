{
  "name": "@stellar-agent-services/payment-client",
  "version": "0.1.1",
  "description": "Buyer-side payment client: approval, spending policy, hash-chained journal, payment and job recovery (PoC).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlgoriaLabs/stellar-agent-services.git",
    "directory": "packages/payment-client"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./node": {
      "types": "./dist/file-storage.d.ts",
      "default": "./dist/file-storage.js"
    },
    "./browser": {
      "types": "./dist/browser-storage.d.ts",
      "default": "./dist/browser-storage.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@stellar-agent-services/protocol": "0.1.1",
    "@stellar/stellar-sdk": "16.4.1",
    "@x402/core": "2.28.0",
    "@x402/stellar": "2.28.0",
    "ajv": "8.20.0"
  },
  "bin": {
    "stellar-pay": "./dist/cli.js"
  },
  "devDependencies": {
    "@stellar-agent-services/provider-kit": "0.1.1",
    "fake-indexeddb": "6.2.5"
  }
}
