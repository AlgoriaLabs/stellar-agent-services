{
  "name": "@stellar-agent-services/verifier",
  "version": "0.1.0",
  "description": "Checks a provider against Provider Standard v1, issues verification receipts and badges, and publishes Stellar 8004 Validation Registry responses.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlgoriaLabs/stellar-agent-services.git",
    "directory": "packages/verifier"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "bin": {
    "verifier": "./dist/cli/index.js"
  },
  "dependencies": {
    "@stellar-agent-services/protocol": "0.1.0",
    "@stellar/stellar-sdk": "16.4.1",
    "@trionlabs/stellar8004": "0.0.11",
    "@x402/core": "2.28.0",
    "@x402/stellar": "2.28.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@stellar-agent-services/provider-kit": "0.1.0"
  }
}
