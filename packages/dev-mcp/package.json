{
  "name": "@stellar-agent-services/dev-mcp",
  "version": "0.1.0",
  "description": "MCP server for coding agents building on Provider Standard v1: spec rules, docs, manifest validation and unpaid provider checks. It never pays.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlgoriaLabs/stellar-agent-services.git",
    "directory": "packages/dev-mcp"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
