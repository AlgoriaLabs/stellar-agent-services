{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorialabs.github.io/stellar-agent-services/schemas/provider/1/verification-receipt.schema.json",
  "$comment": "Rule ids such as [P4] refer to docs/provider-standard.md; the receipt itself is described in docs/verification.md.",
  "title": "Provider Standard v1 verification receipt",
  "description": "What a verifier issues after checking a provider. It is published as RFC 8785 canonical JSON, and the SHA-256 of those bytes is the Stellar 8004 Validation Registry response_hash. Unknown fields are allowed and ignored. Two rules need code as well: level is the highest conformance level whose checks all passed, and score is that level's score.",
  "type": "object",
  "required": ["standard", "network", "validator", "startedAt", "checkedAt", "score", "scoreDirection", "level", "manifest", "results"],
  "properties": {
    "standard": { "const": "stellar-agent-services/provider@1" },
    "agentId": {
      "description": "The provider's Stellar 8004 agent id (u32). Required to publish the receipt to the Validation Registry.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "network": { "enum": ["stellar:testnet", "stellar:pubnet"] },
    "validator": {
      "description": "The verifier's account, which signs validation_response.",
      "type": "string",
      "pattern": "^G[A-D][A-Z2-7]{54}$"
    },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "checkedAt": { "$ref": "#/$defs/timestamp" },
    "score": {
      "description": "The level's score, and the on-chain response: 0, 33, 67 or 100 for levels 0 to 3.",
      "enum": [0, 33, 67, 100]
    },
    "scoreDirection": { "const": "higher-is-better" },
    "level": { "enum": [0, 1, 2, 3] },
    "manifest": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sha256": {
          "description": "SHA-256 of the parsed manifest as canonical JSON. Absent when the manifest could not be read as JSON.",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "results": {
      "description": "One result per check, in order from C1 to C7.",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/checkResult", "type": "object", "properties": { "check": { "const": "C1" } } },
        { "$ref": "#/$defs/checkResult", "type": "object", "properties": { "check": { "const": "C2" } } },
        { "$ref": "#/$defs/checkResult", "type": "object", "properties": { "check": { "const": "C3" } } },
        { "$ref": "#/$defs/checkResult", "type": "object", "properties": { "check": { "const": "C4" } } },
        { "$ref": "#/$defs/checkResult", "type": "object", "properties": { "check": { "const": "C5" } } },
        { "$ref": "#/$defs/checkResult", "type": "object", "properties": { "check": { "const": "C6" } } },
        { "$ref": "#/$defs/checkResult", "type": "object", "properties": { "check": { "const": "C7" } } }
      ],
      "minItems": 7,
      "items": false
    },
    "payment": { "$ref": "#/$defs/paymentReceipt" },
    "tool": {
      "description": "The software that issued the receipt.",
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "level": { "const": 0 } } },
      "then": { "type": "object", "properties": { "score": { "const": 0 } } }
    },
    {
      "if": { "type": "object", "properties": { "level": { "const": 1 } } },
      "then": { "type": "object", "properties": { "score": { "const": 33 } } }
    },
    {
      "if": { "type": "object", "properties": { "level": { "const": 2 } } },
      "then": { "type": "object", "properties": { "score": { "const": 67 } } }
    },
    {
      "if": { "type": "object", "properties": { "level": { "const": 3 } } },
      "then": { "type": "object", "properties": { "score": { "const": 100 } } }
    }
  ],
  "$defs": {
    "timestamp": {
      "description": "RFC 3339.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rule": {
      "description": "A rule id such as P4, or a section such as §5.5 for a requirement without an id.",
      "type": "string",
      "pattern": "^(?:[A-Z][0-9]{1,2}|§[0-9]{1,2}(?:\\.[0-9]{1,2})?)$"
    },
    "checkResult": {
      "type": "object",
      "required": ["check", "status", "failedRules"],
      "properties": {
        "check": { "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7"] },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "failedRules": { "type": "array", "items": { "$ref": "#/$defs/rule" }, "uniqueItems": true },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/rule" }, "uniqueItems": true },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "findings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["rule", "severity", "message"],
            "properties": {
              "rule": { "$ref": "#/$defs/rule" },
              "severity": { "enum": ["fail", "warn"] },
              "message": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        },
        "evidence": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "status": { "const": "failed" } } },
          "then": { "type": "object", "properties": { "failedRules": { "type": "array", "minItems": 1 } } },
          "else": { "type": "object", "properties": { "failedRules": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "type": "object", "properties": { "status": { "const": "skipped" } } },
          "then": { "type": "object", "required": ["reason"] }
        }
      ]
    },
    "paymentReceipt": {
      "description": "The C4 payment, as the job view reported it (provider-standard.md §5.7), after the verifier confirmed it on chain.",
      "type": "object",
      "required": ["network", "asset", "amount", "payTo", "payer", "transaction", "settledAt"],
      "properties": {
        "network": { "enum": ["stellar:testnet", "stellar:pubnet"] },
        "asset": { "type": "string", "pattern": "^C[A-D][A-Z2-7]{54}$" },
        "amount": { "type": "string", "pattern": "^[1-9][0-9]{0,37}$" },
        "payTo": { "type": "string", "pattern": "^[GC][A-D][A-Z2-7]{54}$" },
        "payer": { "type": "string", "pattern": "^[GC][A-D][A-Z2-7]{54}$" },
        "transaction": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "settledAt": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
