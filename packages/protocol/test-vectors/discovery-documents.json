    "openapi": "3.1.0",
    "info": {
      "title": "Example Text Tools",
      "version": "1",
      "description": "Small, deterministic text utilities for agents.",
      "termsOfService": "https://example.com/terms",
      "x-guidance": "Every paid operation here creates one job, following Provider Standard v1 (stellar-agent-services/provider@1). Each job is paid once, in USDC on Stellar testnet (`stellar:testnet`), through x402 v2 with the `exact` scheme. Network fees are sponsored, so the payer needs only USDC. To run a job, POST the input as JSON to the service's path. The answer is 402, with an x402 challenge in the PAYMENT-REQUIRED header; an input that fails the schema is refused with 400 first, so nobody pays for it. Sign the payment, and send the same request again with PAYMENT-SIGNATURE. 200 means the job finished: status is \"succeeded\", with the result in output, or \"failed\", with error. 202 means it is still running: GET /agent/jobs/{jobId}/result with the Job-Token header, no sooner than Retry-After says, until it answers 200. Never pay twice for one job. Send your own Idempotency-Key (a lowercase UUID: it becomes the job id) and Job-Token (32 random bytes as base64url) on both requests, and a lost response can be collected from get-result, free of charge. Without them, the provider sends jobId and jobToken once, in the paid response. The prices in this document are for information: the manifest at https://api.example.com/.well-known/stellar-agent-services.json and the 402 challenge decide."
    },
    "externalDocs": {
      "description": "The Provider Standard v1 manifest: the source of truth for the services, their prices and the payee.",
      "url": "https://api.example.com/.well-known/stellar-agent-services.json"
    },
    "x-service-info": {
