    { "ieee754": "444b1ae4d6e2ef4e", "canonical": "999999999999999700000" },
    { "ieee754": "444b1ae4d6e2ef4f", "canonical": "999999999999999900000" },
    { "ieee754": "444b1ae4d6e2ef50", "canonical": "1e+21" },
