{
  "name": "@stellar-agent-services/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Provider Standard v1 as code: manifest, job, receipt and header definitions shared by every package.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest.schema.json": "./schemas/manifest.schema.json",
    "./verification-receipt.schema.json": "./schemas/verification-receipt.schema.json",
    "./validation-request.schema.json": "./schemas/validation-request.schema.json",
    "./test-vectors/*": "./test-vectors/*"
  },
  "files": [
    "dist",
    "schemas",
    "test-vectors"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "16.3.1",
    "@x402/stellar": "2.28.0",
    "ajv": "8.20.0"
  }
}
